# Compiled class file
*.class

# Log file
log
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
# ...except the vendored dependencies. They are not build output: build.xml
# and the jar manifest both reference lib/ by path, so a checkout without
# them cannot compile SimpleDB or run it. See lib/README for licences.
!lib/*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

bin/*